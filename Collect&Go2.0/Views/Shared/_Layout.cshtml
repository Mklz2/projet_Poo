<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Collect_Go2._0</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Collect_Go2._0.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
  
        @using System.Security.Claims

        <nav class="navbar navbar-expand-lg navbar-dark ">
            <div class="container">

                <a class="navbar-brand text-black fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    🛒 Click & Collect
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">

                    <ul class="navbar-nav me-auto">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Store"
                                   asp-action="Index">
                                    Magasins
                                </a>
                            </li>
                        }

                    </ul>

                    <ul class="navbar-nav">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle text-black"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown">

                                    👤 @User.Identity.Name
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end">

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Account"
                                           asp-action="Logout">
                                            Se déconnecter
                                        </a>
                                    </li>

                                </ul>

                            </li>
                        }
                       @*  else
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Se connecter
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-light ms-2"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Créer un compte
                                </a>
                            </li>
                        } *@

                    </ul>

                </div>
            </div>
        </nav>

    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
