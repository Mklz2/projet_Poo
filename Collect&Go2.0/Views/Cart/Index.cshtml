@model Collect_Go2._0.Models.Order

@{
    ViewData["Title"] = "Mon panier";
}

<div class="container py-5">

    <h1 class="fw-bold mb-4">Mon panier</h1>

    @if (Model.OrderItems.Count == 0)
    {
        <div class="alert alert-info">
            Votre panier est vide.
        </div>

        <a asp-controller="Products" asp-action="Index" class="btn btn-primary">
            Voir les produits
        </a>
    }
    else
    {
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Produit</th>
                    <th>Prix unitaire</th>
                    <th>Quantité</th>
                    <th>Sous-total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderItems)
                {
                    <tr>
                        <td>@item.Product?.Name</td>
                        <td>@item.Product?.Price.ToString("0.00") €</td>
                        <td>@item.Quantity</td>
                        <td>@item.GetOrderItemTotal().ToString("0.00") €</td>
                        <td>
                            <form asp-controller="Cart" asp-action="Remove" method="post">
                                <input type="hidden" name="productId" value="@item.Product?.ProductId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    Retirer
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="text-end fs-5 fw-bold mb-3">
            Total : @Model.GetTotal().ToString("0.00") €
        </div>

        <div class="text-end">
            <a asp-controller="Order" asp-action="Checkout" class="btn btn-primary btn-lg">
                Valider la commande
            </a>
        </div>
    }

</div>
