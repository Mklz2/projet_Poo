
@model List<Collect_Go2._0.Models.Product>

@{
    ViewData["Title"] = "Produits";

    var categories = ViewBag.Categories as List<Collect_Go2._0.Models.Category>;
    var selectedCategory = ViewBag.SelectedCategory as int?;
}

<div class="container py-5">

    <!-- En-tête -->
    <div class="text-center mb-5">
        <h1 class="fw-bold">Nos produits</h1>

        <p class="text-muted">
            Choisissez les produits que vous souhaitez ajouter à votre commande.
        </p>
    </div>


    <!-- Filtre par catégorie -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <div class="row align-items-center">

                <div class="col-md-4">
                    <h5 class="mb-0 fw-bold">
                        Filtrer par catégorie
                    </h5>
                </div>

                <div class="col-md-8">

                    <form asp-controller="Products"
                          asp-action="Index"
                          method="get">

                        <select name="categoryId"
                                class="form-select"
                                onchange="this.form.submit()">

                            <option value="">
                                Toutes les catégories
                            </option>

                            @if (categories != null)
                            {
                                foreach (var category in categories)
                                {
                                    if (selectedCategory == category.CategoryId)
                                    {
                                        <option value="@category.CategoryId"
                                                selected>
                                            @category.Name
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@category.CategoryId">
                                            @category.Name
                                        </option>
                                    }
                                }
                            }

                        </select>

                    </form>

                </div>

            </div>

        </div>
    </div>


    <!-- Produits -->
    @if (Model != null && Model.Count > 0)
    {
        <div class="row g-4">
            @foreach (var product in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 border-0 shadow-sm overflow-hidden">

                        <!-- Image -->
                        <img src="@product.ImageUrl"
                             class="card-img-top"
                             alt="@product.Name"
                             style="height: 220px; object-fit: cover;" />

                        <div class="card-body p-4">

                            <!-- Catégorie + Prix -->
                            <div class="d-flex justify-content-between
                                    align-items-start mb-3">

                                <span class="badge bg-light text-dark">
                                    @product.Category.Name
                                </span>

                                <span class="fw-bold text-primary">
                                    @product.Price.ToString("0.00") €
                                </span>

                            </div>

                            <!-- Nom -->
                            <h4 class="fw-bold">
                                @product.Name
                            </h4>

                            <!-- Description -->
                            <p class="text-muted">
                                @product.Description
                            </p>

                            <!-- Ajouter au panier -->
                            <form asp-controller="Cart" asp-action="Add" method="post" class="mt-4">
                                <input type="hidden" name="productId" value="@product.ProductId" />

                                <div class="input-group mb-2">
                                    <input type="number"
                                           name="quantity"
                                           value="1"
                                           min="1"
                                           class="form-control" />
                                </div>

                                <div class="d-grid">
                                    <button type="submit" class="btn btn-primary">
                                        Ajouter au panier
                                    </button>
                                </div>
                            </form>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            Aucun produit ne correspond à cette catégorie.
        </div>
    }

</div>

