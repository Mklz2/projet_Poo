
@model List<Collect_Go2._0.Models.Stores>

@{
    ViewData["Title"] = "Nos magasins";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">Nos magasins</h1>
        <p class="text-muted">
            Choisissez le magasin dans lequel vous souhaitez récupérer votre commande.
        </p>
    </div>

    <div class="row g-4">

        @foreach (var store in Model)
        {
            <div class="col-md-6 col-lg-4">

                <div class="card h-100 border-0 shadow-sm">

                    <div class="card-body p-4">

                        <div class="text-center mb-3">
                            <div class="fs-1">🏪</div>
                        </div>

                        <h4 class="card-title fw-bold text-center">
                            @store.Name
                        </h4>

                        <p class="card-text text-muted text-center">
                            📍 @store.Address
                        </p>

                        <div class="d-grid mt-4">
                            <a href="#"
                               class="btn btn-primary">
                                Choisir ce magasin
                            </a>
                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>
